+// @vitest-environment jsdom
+import { afterEach, expect, it, vi } from "vite-plus/test";
+
+const sortedDescriptor = Object.getOwnPropertyDescriptor(Array.prototype, "toSorted")!;
+
+afterEach(() => {
+  Reflect.defineProperty(Array.prototype, "toSorted", sortedDescriptor);
+  vi.unstubAllGlobals();
+});
+
+it("restores missing array methods and adopts a diff stylesheet before app startup", async () => {
+  Reflect.deleteProperty(Array.prototype, "toSorted");
+  vi.stubGlobal("CSS", { supports: () => false });
+  document.documentElement.style.setProperty("--boot-background", "oklch(1 0 0)");
+  expect(() => [2, 1].toSorted()).toThrow();
+
+  const { prepareLegacyBrowser } = await import("./legacyBrowser");
+  await prepareLegacyBrowser();
+
+  expect([2, 1].toSorted()).toEqual([1, 2]);
+  expect(document.documentElement.style.getPropertyValue("--boot-background")).toBe(
+    "rgb(255, 255, 255)",
+  );
+  const sheet = new CSSStyleSheet();
+  sheet.replaceSync(":host { color: oklch(0 0 0); }");
+  const host = document.createElement("div");
+  document.body.append(host);
+  const shadow = host.attachShadow({ mode: "open" });
+  shadow.adoptedStyleSheets = [sheet];
+  expect(shadow.adoptedStyleSheets).toEqual([sheet]);
+});
diff --git a/apps/web/src/legacyBrowser.ts b/apps/web/src/legacyBrowser.ts
new file mode 100644
index 000000000..99891c2f3
--- /dev/null
+++ b/apps/web/src/legacyBrowser.ts
@@ -0,0 +1,24 @@
+import "core-js/actual";
+
+import { browserThemeColor } from "./lib/legacyColor";
+import { legacyCssValue } from "./lib/legacyCssValue";
+
+// Await this before importing React or any dependency that uses the missing APIs.
+export async function prepareLegacyBrowser(): Promise<void> {
+  if (typeof document === "undefined" || !document.implementation) return;
+  if (!("adoptedStyleSheets" in document)) {
+    await import("construct-style-sheets-polyfill");
+    const replaceSync = CSSStyleSheet.prototype.replaceSync;
+    CSSStyleSheet.prototype.replaceSync = function (css: string) {
+      return replaceSync.call(this, legacyCssValue(css));
+    };
+  }
+
+  // index.html paints the theme before the module entry; repair its literal colours too.
+  const root = document.documentElement;
+  for (const name of Array.from(root.style)) {
+    const value = root.style.getPropertyValue(name);
+    const supported = browserThemeColor(value);
+    if (supported !== value) root.style.setProperty(name, supported);
+  }
+}
