new file mode 100644
index 000000000..7b092486d
--- /dev/null
+++ b/apps/web/src/lib/legacyColor.ts
@@ -0,0 +1,9 @@
+import "culori/css";
+import { formatRgb, parse } from "culori/fn";
+
+/** Stored palettes remain canonical; only values sent to old browser CSS are converted. */
+export function browserThemeColor(value: string): string {
+  if (typeof CSS === "undefined" || CSS.supports("color", "oklch(0.5 0 0)")) return value;
+  const color = parse(value);
+  return color ? formatRgb(color) : value;
+}
