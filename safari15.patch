+import { describe, expect, it } from "vite-plus/test";
+
+import { legacyCss } from "../../vite/legacyCss";
+import { legacyCssValue } from "./legacyCssValue";
+
+describe("Safari 15 CSS output", () => {
+  it("keeps sidebar rows visible without combined fade masks or unsupported viewport units", () => {
+    const css = legacyCss(`.sidebar { height: 100svh; mask-image: linear-gradient(black, transparent); -webkit-mask-composite: source-in; }`);
+    expect(css).not.toContain("mask-image");
+    expect(css).not.toContain("mask-composite");
+    expect(css).toContain("height: 100vh");
+  });
+  it("converts palette literals while preserving variable references and gradients", () => {
+    const css = legacyCss(`:root { --background: oklch(1 0 0); }
+      .panel { background: linear-gradient(oklch(0 0 0), color-mix(in oklab, var(--background) calc(80% + 1%), transparent)); }`);
+    expect(css).not.toContain("oklch(");
+    expect(css).not.toContain("color-mix(");
+    expect(css).toContain("--background: #fff");
+    expect(css).toContain("linear-gradient(#000, var(--background))");
+  });
+
+  it("flattens shadow-root nesting and initializes properties without CSS registration", () => {
+    const css =
+      legacyCss(`@property --tw-shadow { syntax: "*"; inherits: false; initial-value: 0 0 #0000; }
+      .diff { & .line { color: red; } }`);
+    expect(css).not.toContain("@property");
+    expect(css).toContain("--tw-shadow: 0 0 #0000");
+    expect(css).toContain(".diff .line");
+  });
+
+  it("keeps both theme choices available without light-dark support", () => {
+    expect(legacyCssValue("light-dark(#fff, #000)")).toBe(
+      "var(--legacy-light, #fff) var(--legacy-dark, #000)",
+    );
+  });
+});
diff --git a/apps/web/src/lib/legacyCssValue.ts b/apps/web/src/lib/legacyCssValue.ts
new file mode 100644
index 000000000..983c4e554
--- /dev/null
+++ b/apps/web/src/lib/legacyCssValue.ts
@@ -0,0 +1,45 @@
+import "culori/css";
+import { formatRgb, parse } from "culori/fn";
+import valueParser from "postcss-value-parser";
+
+/** Safari 15 gets solid colours in place of unsupported variable-based colour mixing. */
+export function legacyCssValue(value: string): string {
+  const parsed = valueParser(value);
+  const visit = (nodes: valueParser.Node[]) => {
+    for (const node of nodes) {
+      if (node.type !== "function") continue;
+      visit(node.nodes);
+      if (["oklch", "oklab", "lab", "lch", "color"].includes(node.value)) {
+        const color = parse(valueParser.stringify(node));
+        if (color) {
+          Object.assign(node, { type: "word", value: formatRgb(color) });
+        }
+      } else if (node.value === "color-mix" || node.value === "light-dark") {
+        const args: valueParser.Node[][] = [[]];
+        for (const child of node.nodes) {
+          if (child.type === "div" && child.value === ",") args.push([]);
+          else args[args.length - 1]!.push(child);
+        }
+        if (node.value === "light-dark") {
+          const light = valueParser.stringify(args[0] ?? []).trim();
+          const dark = valueParser.stringify(args[1] ?? []).trim();
+          Object.assign(node, {
+            type: "word",
+            value: `var(--legacy-light, ${light}) var(--legacy-dark, ${dark})`,
+          });
+          continue;
+        }
+        const color = args[1];
+        if (color) {
+          const expression = color.find(
+            (child) => child.type !== "space" && child.type !== "comment",
+          );
+          const fallback = expression ? valueParser.stringify(expression) : "transparent";
+          Object.assign(node, { type: "word", value: fallback });
+        }
+      }
+    }
+  };
+  visit(parsed.nodes);
+  return parsed.toString();
+}
