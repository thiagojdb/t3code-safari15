diff --git a/apps/web/vite/legacyCss.ts b/apps/web/vite/legacyCss.ts
new file mode 100644
index 000000000..be88e4a3e
--- /dev/null
+++ b/apps/web/vite/legacyCss.ts
@@ -0,0 +1,83 @@
+import postcss from "postcss";
+import { transform, Features } from "lightningcss";
+import type { Plugin } from "vite-plus";
+
+import { legacyCssValue } from "../src/lib/legacyCssValue";
+
+export function legacyCss(css: string): string {
+  const root = postcss.parse(css);
+  const initial = new Map<string, string>();
+  root.walkAtRules("property", (rule) => {
+    let inherits = false;
+    rule.walkDecls("inherits", (decl) => {
+      inherits = decl.value === "true";
+    });
+    rule.walkDecls("initial-value", (decl) => {
+      if (!inherits) initial.set(rule.params, legacyCssValue(decl.value));
+    });
+    rule.remove();
+  });
+  root.walkDecls((decl) => {
+    // Safari 15 cannot reliably compose Tailwind's multi-axis scroll fades.
+    // A broken mask hides every thread row while leaving the header visible.
+    if (/^(?:-webkit-)?mask(?:-|$)/.test(decl.prop)) {
+      decl.remove();
+      return;
+    }
+    decl.value = legacyCssValue(decl.value);
+    decl.value = decl.value.replace(/\b([\d.]+)[dsl]vh\b/g, "$1vh").replace(/\b([\d.]+)[dsl]vw\b/g, "$1vw");
+  });
+  if (initial.size) {
+    const layer = postcss.atRule({ name: "layer", params: "properties" });
+    const rule = postcss.rule({ selector: "*,::before,::after,::backdrop" });
+    for (const [prop, value] of initial) rule.append(postcss.decl({ prop, value }));
+    layer.append(rule);
+    root.prepend(layer);
+  }
+  const result = transform({
+    filename: "legacy.css",
+    code: Buffer.from(root.toString()),
+    targets: { safari: (15 << 16) | (6 << 8) },
+    include: Features.Nesting,
+    minify: false,
+  });
+  return new TextDecoder().decode(result.code);
+}
+
+export function legacyCssPlugin(): Plugin {
+  return {
+    name: "t3code:safari15-css",
+    enforce: "post",
+    // Diff styles are shipped as a JavaScript string, not as a CSS asset.
+    transform(code, id) {
+      if (!id.includes("@pierre/diffs/dist/")) return;
+      if (id.endsWith("/utils/cssWrappers.js")) {
+        const helper = new URL("../src/lib/legacyCssValue.ts", import.meta.url).pathname;
+        return (
+          `import { legacyCssValue } from ${JSON.stringify(helper)};\n` +
+          code
+            .replace("function wrapThemeCSS(themeCSS,", "function wrapThemeCSS(rawThemeCSS,")
+            .replace(
+              "const colorSchemeRule =",
+              "const themeCSS = legacyCssValue(rawThemeCSS);\nconst colorSchemeRule =",
+            )
+        );
+      }
+      return code.replace(
+        /(var (?:style|editor)_default = )("(?:[^"\\]|\\.)*")/,
+        (_match, prefix, literal) => prefix + JSON.stringify(legacyCss(JSON.parse(literal))),
+      );
+    },
+    generateBundle(_options, bundle) {
+      for (const asset of Object.values(bundle)) {
+        if (asset.type === "asset" && asset.fileName.endsWith(".css")) {
+          const css =
+            typeof asset.source === "string"
+              ? asset.source
+              : new TextDecoder().decode(asset.source);
+          asset.source = legacyCss(css);
+        }
+      }
+    },
+  };
+}
diff --git a/apps/web/vite/legacyRegex.ts b/apps/web/vite/legacyRegex.ts
new file mode 100644
index 000000000..bc3e3c4d2
--- /dev/null
+++ b/apps/web/vite/legacyRegex.ts
@@ -0,0 +1,26 @@
+import type { Plugin } from "vite-plus";
+
+export function legacyRegexSource(code: string, id: string): string {
+  if (id.includes("mdast-util-gfm-autolink-literal")) {
+    // findEmail already validates the preceding character through previous(match, true).
+    return code.replace(String.raw`(?<=^|\s|\p{P}|\p{S})`, "");
+  }
+  if (id.includes("@pierre/diffs") && id.endsWith("/constants.js")) {
+    return code.replace(
+      String.raw`const SPLIT_WITH_NEWLINES = /(?<=\n)/;`,
+      String.raw`const SPLIT_WITH_NEWLINES = { [Symbol.split](text) { return text.match(/[^\n]*\n|[^\n]+$/g) || []; } };`,
+    );
+  }
+  return code;
+}
+
+export function legacyRegexPlugin(): Plugin {
+  return {
+    name: "t3code:safari15-regex",
+    enforce: "pre",
+    transform(code, id) {
+      const result = legacyRegexSource(code, id);
+      return result !== code ? result : undefined;
+    },
+  };
+}
