@@ -0,0 +1,17 @@
+/** Relative builds can be served below a publication path without knowing its ID at build time. */
+export function resolveAppBasePath(base: string, moduleUrl: string): string {
+  const path = base === "./" ? new URL("../", moduleUrl).pathname : base;
+  return path.replace(/\/$/, "") || "/";
+}
+
+export const appBasePath = resolveAppBasePath(import.meta.env.BASE_URL, import.meta.url);
+
+export function appPath(path: string): string {
+  return `${appBasePath === "/" ? "" : appBasePath}/${path.replace(/^\//, "")}`;
+}
+
+export function stripAppBasePath(path: string): string {
+  return appBasePath !== "/" && path.startsWith(`${appBasePath}/`)
+    ? path.slice(appBasePath.length)
+    : path;
+}
